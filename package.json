{
  "name": "dsh-group-status",
  "version": "0.5.3",
  "description": "DSH 侧栏折叠分组的聚合状态徽标：分组收起时在文件夹行显示组内会话的待审批、进行中与已完成状态，并合并其他插件注册的状态源，带计数与悬停明细。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "group-status",
    "badge",
    "sidebar",
    "workspace",
    "deepseek-ai"
  ],
  "author": "WuJiaoJue",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugin-collection/dsh-group-status.git"
  },
  "homepage": "https://github.com/dsh-plugin-collection/dsh-group-status",
  "bugs": {
    "url": "https://github.com/dsh-plugin-collection/dsh-group-status/issues"
  },
  "engines": {
    "node": "^22.19 || >=24",
    "dsh": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-alpha.2 <0.2.3-0"
  },
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remote-access",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-api-remote-access": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.2 || ^0.2.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remote-access": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-product-analytics": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-shortcuts": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-test-runtime": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.1",
    "@deepseek-ai/dsh-jobs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-schedule": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~18.3.1",
    "clsx": "^2.0.0",
    "immer": "10.2.0",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.29.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "~5.9.2",
    "vitest": "4.1.11",
    "zustand": "5.0.10"
  },
  "files": [
    "icon.svg",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "lib/types",
    "!lib/types/**/*.js",
    "!lib/types/**/*.js.map",
    "!lib/types/**/*.d.ts.map",
    "cordis.patch.yml",
    "docs/media",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "types": "tsc -p tsconfig.json",
    "bundle": "npm run types && tsdown",
    "build": "npm run bundle",
    "watch": "tsdown --watch",
    "test": "npm run test:node && npm run test:spec",
    "test:node": "npm run types && node --test tests/*.node.test.mjs",
    "test:spec": "vitest run",
    "test:watch": "vitest",
    "check-upstream": "npx tsx scripts/check-upstream.ts",
    "prepublishOnly": "npm run build"
  }
}
